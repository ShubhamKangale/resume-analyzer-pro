# Copy this file to ".env" (same folder as app.py) and fill in your values.
# NEVER share/upload/commit your real .env.

DB_PASSWORD=your_mysql_root_password
RESUME_ANALYZER_SECRET_KEY=change-me-to-a-long-random-string

# --- Gemini (AI features) ---
GEMINI_API_KEY=your_gemini_key
# Optional. Default is gemini-3.1-flash-lite (gemini-2.5-* no longer works for new keys)
# LLM_MODEL=gemini-3.1-flash-lite

# --- Email via Brevo API ---
BREVO_API_KEY=your_brevo_api_key
# MUST be a sender you added AND verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=AI Resume Analyzer
APP_BASE_URL=http://localhost:5000

# Dev only: 1 = skip email verification at registration (new users can log in immediately)
# SKIP_EMAIL_VERIFICATION=0
